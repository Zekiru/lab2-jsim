.include "8clocks.jsim"
.include "nominal.jsim"
.include "stdcell.jsim"


*******************************************************************************
* Function fx (NAND Gates Implementation):
*     OUT = AB + CDE + FG
*         = ![!(AB) !(CDE) !(FG)]
* 
* Let X = AB, Y = CDE, Z = FG
*     OUT = X + Y + Z
*         = !(!X !Y !Z) <-- De Morgan's Law
* Hence:
*     OUT = ![!(AB) !(CDE) !(FG)]
* 
* Why NANDs Only?
* - Using AND & OR directly requires more transistors; those gates
*   are essentially NAND & NOR gates with inverted inputs/outputs.
* - Simplifies the circuit by using less gates (4 NANDs) and only one
*   gate type, as opposed to the inital AND & OR setup that
*   uses 3 NANDs & 2 ORs.
*******************************************************************************

.subckt fx a b c d e f g out
    X1 a b x nand2
    X2 c d e y nand3
    X3 f g z nand2
    X4 x y z out nand3
.ends

Xfx clk1 clk2 clk3 clk4 clk5 clk6 clk7 out fx


*******************************************************************************
* Function fa (NAND & XOR Gate Implementation):
*     SUM   = A ⊕ B ⊕ C_IN
*     CARRY_OUT = AB + (A ⊕ B) C_IN
*           = ![!(AB) !((A ⊕ B) C_IN)]
*
* Let X = AB, Y = (A ⊕ B) C_IN
*     CARRY_OUT = X + Y
*           = !(!X !Y) <-- De Morgan's Law
* Hence:
*     CARRY_OUT = ![!(AB) !((A ⊕ B) C_IN)]
* 
* Why use XORs?
* - Translating a XOR gate using the other gates is redundant; XOR is
*   already optimized similar to how NANDs & NORs are utilized.
* - This particular gate is an important component for bit adders,
*   as the sum component only needs to check if an odd sum is present,
*   and the carry out handles if it overflows to a decimal sum of >= 2.
*
* Why use NANDs?
* - Similar reasoning from function fx
*******************************************************************************

.subckt fa a b carry_in sum carry_out
    Xsum1 a b i xor2
    Xsum2 i carry_in sum xor2
    Xc_out1 a b j nand2
    Xc_out2 i carry_in k nand2
    Xc_out3 j k carry_out nand2
.ends

Xfa clk1 clk2 clk3 sum carry_out fa


*******************************************************************************
* Transient and Plot Commands.
* A .tran >= 640 is needed to display all the states of clk1-clk7 properly.
*******************************************************************************

.tran 650ns
.plot clk1
.plot clk2
.plot clk3
.plot clk4
.plot clk5
.plot clk6
.plot clk7
.plot sum
.plot out
.plot carry_out


